@startuml
skinparam backgroundColor #ffffff
skinparam defaultFontName Arial
skinparam defaultFontSize 13
skinparam roundcorner 10
skinparam shadowing false

skinparam object {
  BackgroundColor #ffffff
  BorderColor #0284c7
  BorderThickness 2
  FontColor #0f172a
  FontSize 13
}

skinparam arrow {
  Color #0284c7
  FontColor #334155
  FontSize 12
  Thickness 1.5
}

