<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#082032">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingLeft="12dp"
        android:paddingRight="12dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:background="#082032">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="DiaMon GPS · Chapacuá"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:textSize="15sp" />

        <Button
            android:id="@+id/btnAbrirCrudSqlite"
            android:layout_width="wrap_content"
            android:layout_height="38dp"
            android:text="CRUD SQLite"
            android:textSize="11sp"
            android:onClick="mostrarCrudClinico"
            android:backgroundTint="#0D9488"
            android:textColor="#FFFFFF" />

        <Button
            android:id="@+id/btnIrLoginApp"
            android:layout_width="wrap_content"
            android:layout_height="38dp"
            android:layout_marginLeft="6dp"
            android:text="Login / Cuenta"
            android:textSize="11sp"
            android:onClick="irALogin"
            android:backgroundTint="#0284C7"
            android:textColor="#FFFFFF" />
    </LinearLayout>

    <WebView
        android:id="@+id/webViewDiaMon"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

</LinearLayout>
