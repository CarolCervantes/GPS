<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#F0F5F7">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Cabecera Clínica Oscura Azul-Verde -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#061B2E"
            android:paddingLeft="20dp"
            android:paddingRight="20dp"
            android:paddingTop="42dp"
            android:paddingBottom="22dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="← Volver al Panel"
                android:textColor="#5EEAD4"
                android:textSize="13sp"
                android:textStyle="bold"
                android:paddingTop="4dp"
                android:paddingBottom="10dp"
                android:clickable="true"
                android:focusable="true"
                android:onClick="abrirDashboardMapa" />

            <TextView
                android:id="@+id/etiTituloCrud"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Registro Clínico SQLite"
                android:textSize="22sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF" />

            <TextView
                android:id="@+id/etiSubCrud"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Almacenamiento local offline + sincronización automática con Supabase."
                android:textSize="12.5sp"
                android:textColor="#BAE6FD" />
        </LinearLayout>

        <!-- Tarjeta Formulario -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_crud_card"
            android:layout_margin="14dp"
            android:padding="18dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="12dp">

                <TextView
                    android:id="@+id/etiId"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="ID Registro"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textColor="#334155" />

                <EditText
                    android:id="@+id/campoId"
                    android:layout_width="0dp"
                    android:layout_height="42dp"
                    android:layout_weight="1"
                    android:layout_marginLeft="12dp"
                    android:background="@drawable/bg_crud_input"
                    android:paddingLeft="12dp"
                    android:paddingRight="12dp"
                    android:textColor="#0F172A"
                    android:textStyle="bold"
                    android:textSize="14sp"
                    android:inputType="number"
                    android:enabled="false" />
            </LinearLayout>

            <TextView
                android:id="@+id/etiPaciente"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Paciente"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="#334155"
                android:layout_marginBottom="4dp" />

            <EditText
                android:id="@+id/campoPaciente"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:background="@drawable/bg_crud_input"
                android:paddingLeft="14dp"
                android:paddingRight="14dp"
                android:text="Damián Díaz Balseiro"
                android:textColor="#0F172A"
                android:textSize="14.5sp"
                android:inputType="textPersonName"
                android:layout_marginBottom="12dp" />

            <TextView
                android:id="@+id/etiGlucosa"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Glucosa Capilar (mg/dL)"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="#334155"
                android:layout_marginBottom="4dp" />

            <EditText
                android:id="@+id/campoGlucosa"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:background="@drawable/bg_crud_input"
                android:paddingLeft="14dp"
                android:paddingRight="14dp"
                android:hint="Ej: 114 mg/dL (En ayunas)"
                android:textColor="#0F172A"
                android:textColorHint="#94A3B8"
                android:textSize="14.5sp"
                android:inputType="text"
                android:layout_marginBottom="12dp" />

            <TextView
                android:id="@+id/etiPresion"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Presión Arterial (mmHg)"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="#334155"
                android:layout_marginBottom="4dp" />

            <EditText
                android:id="@+id/campoPresion"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:background="@drawable/bg_crud_input"
                android:paddingLeft="14dp"
                android:paddingRight="14dp"
                android:hint="Ej: 126/78 mmHg (71 BPM)"
                android:textColor="#0F172A"
                android:textColorHint="#94A3B8"
                android:textSize="14.5sp"
                android:inputType="text"
                android:layout_marginBottom="12dp" />

            <TextView
                android:id="@+id/etiMedicamento"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Medicamento / Insulina Aplicada"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="#334155"
                android:layout_marginBottom="4dp" />

            <EditText
                android:id="@+id/campoMedicamento"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:background="@drawable/bg_crud_input"
                android:paddingLeft="14dp"
                android:paddingRight="14dp"
                android:hint="Ej: Metformina / Insulina 24 UI"
                android:textColor="#0F172A"
                android:textColorHint="#94A3B8"
                android:textSize="14.5sp"
                android:inputType="text"
                android:layout_marginBottom="12dp" />

            <TextView
                android:id="@+id/etiUbicacion"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Ubicación GPS"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="#334155"
                android:layout_marginBottom="4dp" />

            <EditText
                android:id="@+id/campoUbicacion"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:background="@drawable/bg_crud_input"
                android:paddingLeft="14dp"
                android:paddingRight="14dp"
                android:text="Casa Chapacuá (Lat: 10.39991, Lng: -75.47886)"
                android:textColor="#0F172A"
                android:textSize="14sp"
                android:inputType="text"
                android:layout_marginBottom="16dp" />

            <!-- Botón Principal Guardar -->
            <Button
                android:id="@+id/botonGuardar"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:text="Guardar Registro Clínico"
                android:textAllCaps="false"
                android:textStyle="bold"
                android:textSize="15sp"
                android:textColor="#FFFFFF"
                android:onClick="agregarRegistro"
                android:backgroundTint="#0D9488" />

            <!-- Fila Secundaria: Buscar y Limpiar -->
            <LinearLayout
                android:id="@+id/filaBotones1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/botonBuscar"
                    android:layout_width="0dp"
                    android:layout_height="46dp"
                    android:layout_weight="1"
                    android:text="Buscar ID"
                    android:textAllCaps="false"
                    android:textColor="#FFFFFF"
                    android:onClick="mostrarCuadroDialogoId"
                    android:backgroundTint="#082F49" />

                <Button
                    android:id="@+id/botonLimpiar"
                    android:layout_width="0dp"
                    android:layout_height="46dp"
                    android:layout_weight="1"
                    android:layout_marginLeft="8dp"
                    android:text="Limpiar"
                    android:textAllCaps="false"
                    android:textColor="#FFFFFF"
                    android:onClick="limpiarCampos"
                    android:backgroundTint="#475569" />
            </LinearLayout>

            <!-- Fila Modificar y Eliminar -->
            <LinearLayout
                android:id="@+id/filaBotones2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/botonModificar"
                    android:layout_width="0dp"
                    android:layout_height="46dp"
                    android:layout_weight="1"
                    android:text="Modificar"
                    android:textAllCaps="false"
                    android:textColor="#FFFFFF"
                    android:onClick="modificarRegistro"
                    android:backgroundTint="#0284C7" />

                <Button
                    android:id="@+id/botonEliminar"
                    android:layout_width="0dp"
                    android:layout_height="46dp"
                    android:layout_weight="1"
                    android:layout_marginLeft="8dp"
                    android:text="Eliminar"
                    android:textAllCaps="false"
                    android:textColor="#FFFFFF"
                    android:onClick="eliminarRegistro"
                    android:backgroundTint="#DC2626" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</ScrollView>
